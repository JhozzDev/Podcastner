<Window   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Podcastner.MainWindow"
        Title="Podcastner"
        Height="780"
        Width="1280"
        MinHeight="600"
        MinWidth="900"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        FontFamily="Segoe UI"
>
    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#1DB954"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1ED760"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="CardBrush" Color="#242424"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="CardSelectedBrush" Color="#1DB954"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3B3B3"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#2A2A2A"/>

        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0"
                Background="#222">

         

            <Button 
        x:Name="Podcast"
        Style="{StaticResource PlayerButtonStyle}"
        Content="🔍"
        Click="Button_Click"
      />

            <Button 
        x:Name="Dictionary"
        Style="{StaticResource PlayerButtonStyle}"
        Content="🔍"
        Click="Button_Click"
      />


            <Button x:Name="Words"
        Style="{StaticResource PlayerButtonStyle}"
        Content="🔍"
        Click="Button_Click"
      />

        </StackPanel>



        <ContentControl x:Name="MainContent"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"/>

    </Grid>

</Window>
