<Window   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Podcastner.MainWindow"
        Title="Podcastner"
        Height="780"
        Width="1280"
        MinHeight="600"
        MinWidth="900"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        FontFamily="Segoe UI"
      >

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0"
                Background="#222">

            <Button 
                x:Name="Podcast"
                Content="Podcast"
                Click="Button_Click"/>


        </StackPanel>



        <ContentControl x:Name="MainContent"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"/>

    </Grid>

</Window>
